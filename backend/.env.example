# Database connection
PGHOST=localhost
PGPORT=5432
PGUSER=customs
PGPASSWORD=change_me
PGDATABASE=customs_accounting

# Server
PORT=4000

# JWT secret - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRES=7d

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Default admin account created on init
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_FULLNAME=مدير النظام